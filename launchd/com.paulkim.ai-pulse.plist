<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.paulkim.ai-pulse</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/paul.kim/ai-pulse/scripts/run_daily.sh</string></array>
  <!-- 매일 06:00 (Mac 시간대 = KST). 잠자기 중이면 깨어난 직후 실행 -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/paul.kim/ai-pulse/data/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/paul.kim/ai-pulse/data/launchd.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
